{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "where-to-move-redirect",
  "main": "cloudflare/redirect-worker.mjs",
  "compatibility_date": "2026-09-04",
  "routes": [
    {
      "pattern": "where-to-move.com",
      "custom_domain": true
    },
    {
      "pattern": "www.where-to-move.com",
      "custom_domain": true
    }
  ]
}
